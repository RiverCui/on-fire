# Database (Neon Postgres via Vercel Marketplace)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/dbname?sslmode=require

AUTH_SECRET=replace-me

# AI provider switch: deepseek | anthropic | openai
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Upstash Redis (from Vercel Marketplace integration)
# Values are auto-provisioned by Vercel; run `vercel env pull .env` to sync
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
